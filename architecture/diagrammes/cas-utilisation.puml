@startuml cas-utilisation
' Diagramme de cas d'utilisation UML
' Système d'automatisation de la supervision réseau
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Administrateur" as admin
actor "Système (Cron)" as cron
actor "Service Telegram" as tg
actor "Serveur SMTP" as smtp

rectangle "Système de supervision réseau" {
  usecase "S'authentifier" as UC0
  usecase "Gérer les équipements\n(ajouter/modifier/supprimer)" as UC1
  usecase "Découvrir le réseau\nautomatiquement" as UC2
  usecase "Consulter le tableau de bord" as UC3
  usecase "Superviser les équipements\n(ping + services)" as UC4
  usecase "Journaliser les événements" as UC5
  usecase "Détecter une panne" as UC6
  usecase "Déclencher une alerte" as UC7
  usecase "Envoyer alerte e-mail" as UC8
  usecase "Envoyer alerte Telegram" as UC9
  usecase "Acquitter une alerte" as UC10
  usecase "Consulter les rapports\net statistiques" as UC11
}

admin --> UC0
admin --> UC1
admin --> UC2
admin --> UC3
admin --> UC10
admin --> UC11

cron --> UC4

UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC6 ..> UC7 : <<extend>>
UC7 ..> UC8 : <<include>>
UC7 ..> UC9 : <<include>>
UC1 ..> UC0 : <<include>>
UC3 ..> UC0 : <<include>>

UC8 --> smtp
UC9 --> tg

@enduml
