# ====================================================================== #
#  Fichier d'exemple de configuration. Copiez-le en « .env » et adaptez. #
#  Le fichier .env NE DOIT JAMAIS être versionné (voir .gitignore).      #
# ====================================================================== #

# --- Application Flask ---
SECRET_KEY=remplacez-par-une-cle-aleatoire-longue
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=supervision
DB_USER=supervisor
DB_PASSWORD=mot_de_passe_solide

# --- Paramètres des sondes ---
PING_COUNT=3
PING_TIMEOUT=2
FAILURE_THRESHOLD=2

# --- Supervision SNMP (optionnelle) ---
# Mettre SNMP_ENABLED=True pour enrichir chaque cycle avec les infos SNMP
# (nom système, uptime) des équipements disposant d'un agent SNMP.
SNMP_ENABLED=False
SNMP_VERSION=2c
SNMP_COMMUNITY=public
SNMP_TIMEOUT=2

# --- Alertes e-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=mot_de_passe_application
ALERT_EMAIL_FROM=supervision@exemple.com
ALERT_EMAIL_TO=admin1@exemple.com,admin2@exemple.com

# --- Bot Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAExempleDeJetonBotTelegram
TELEGRAM_CHAT_ID=987654321

# --- Journalisation ---
LOG_DIR=logs
LOG_FILE=supervision.log
LOG_LEVEL=INFO
