# Secrets et configuration locale — NE JAMAIS versionner
.env
src/.env
*.env.local

# Environnement virtuel Python
venv/
env/
ENV/
.venv/

# Caches et fichiers compilés Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Journaux
logs/
*.log

# Base de données locale / dumps
*.sql.bak
*.sqlite
*.db

# Fichiers d'environnement de développement
.idea/
.vscode/
*.swp
.DS_Store

# Images SVG des diagrammes (régénérables depuis les .puml)
architecture/diagrammes/*.svg
# Les PNG des diagrammes UML/architecture sont des LIVRABLES versionnés
# (utilisés dans le mémoire et la présentation) : on les conserve.

# Exports de documents générés
*.pdf
*.docx
*.pptx
# Exceptions : livrables versionnés (présentation + mémoire Word)
!soutenance/presentation-projet.pptx
!memoire/memoire-projet-OPEN-MOISE.docx
!memoire/memoire-KOUASSI-ESPERANCE.docx
!memoire/Memoire-KOUASSI-ESPERANCE-CERCO.docx
